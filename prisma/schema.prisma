generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime (serverless): pakai Connection Pooler Supabase (port 6543, ?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Migrasi / prisma db push: pakai Direct/Session connection (port 5432)
  directUrl = env("DIRECT_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  price       Int // dalam Rupiah (tanpa desimal)
  emoji       String      @default("☕")
  image       String? // foto produk (data URL / URL) — opsional
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([categoryId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String?
  customerPhone String? // diisi pelanggan yang memesan lewat QR meja
  customerEmail String?
  /// CASHIER = dibuat kasir di konter, QR_TABLE = dipesan pelanggan lewat QR meja
  orderType     String      @default("CASHIER")
  tableNumber   String? // nomor meja asal pemesanan QR
  subtotal      Int
  tax           Int         @default(0)
  total         Int
  paymentMethod String // CASH | QRIS
  cashReceived  Int?
  change        Int?
  status        String      @default("PAID") // PAID | PENDING | CANCELLED
  paymentRef    String? // ID transaksi Midtrans (untuk QRIS)
  /// Untaian EMVCo yang tercetak pada kode QR — dipakai memcocokkan hasil pindaian
  qrPayload     String?
  /// Saat pelanggan menyatakan sudah membayar QRIS merchant toko. Pembayaran
  /// lewat QRIS statis tidak melapor ke aplikasi, jadi sinyal ini yang memberi
  /// tahu kasir bahwa saldo perlu diperiksa.
  claimedPaidAt DateTime?
  /// URL gambar QR di Midtrans; dipakai pemindai uji coba pada mode sandbox
  qrUrl         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([orderType, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String // snapshot nama saat transaksi
  price     Int // snapshot harga saat transaksi
  quantity  Int
  subtotal  Int

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}
